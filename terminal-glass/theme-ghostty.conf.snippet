# >>> terminal-glass (managed by omarchy-plugins/terminal-glass) >>>
# Omarchy's glassy mode only writes its own 0.65 alpha when this line is
# missing, so this pin keeps the terminal opaque and leaves the glass to the
# Hyprland rule at the end of ~/.config/hypr/hyprland.lua.
background-opacity = 1
# <<< terminal-glass (managed by omarchy-plugins/terminal-glass) <<<
