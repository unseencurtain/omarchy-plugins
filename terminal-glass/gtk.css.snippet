/* >>> terminal-glass (managed by omarchy-plugins/terminal-glass) >>> */
/* GTK4 hands blur to the compositor only when CSS asks for a backdrop effect.
   Ghostty reads the file above via gtk-custom-css; this copy keeps blur behind
   every other translucent GTK4 window (Nautilus, ...) as well. */
window {
  backdrop-filter: blur(6px);
}
/* <<< terminal-glass (managed by omarchy-plugins/terminal-glass) <<< */
